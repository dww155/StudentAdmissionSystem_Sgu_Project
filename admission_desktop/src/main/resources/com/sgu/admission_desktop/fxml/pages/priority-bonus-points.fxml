<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.sgu.admission_desktop.controller.PriorityBonusPointsPageController"
      styleClass="page"
      spacing="14.0"
      VBox.vgrow="ALWAYS">
    <VBox styleClass="card"
          spacing="12.0"
          VBox.vgrow="ALWAYS">
        <HBox styleClass="toolbar" spacing="10.0">
            <Label text="Quản lý điểm cộng ưu tiên" styleClass="card-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <TextField fx:id="searchField" promptText="Nhập CCCD"/>
            <Button text="Tìm" onAction="#onSearchByCccd" styleClass="icon-btn"/>
            <Button text="Import" onAction="#onImport" styleClass="btn-success"/>
            <Button text="Thêm mới" onAction="#onAddNew" styleClass="btn-primary"/>
            <Button text="Sửa đã chọn" onAction="#onUpdateSelected" styleClass="icon-btn"/>
            <Button text="Xóa đã chọn" onAction="#onDeleteSelected" styleClass="icon-btn"/>
        </HBox>

        <TableView fx:id="table"
                   styleClass="table"
                   VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colCccd" text="CCCD"/>
                <TableColumn fx:id="colLevel" text="Level"/>
                <TableColumn fx:id="colTeam" text="Team"/>
                <TableColumn fx:id="colSubjectCode" text="Subject code"/>
                <TableColumn fx:id="colPrizeType" text="Prize type"/>
                <TableColumn fx:id="colBonusPointForSubject" text="Điểm cộng môn"/>
                <TableColumn fx:id="colBonusPointForSubjectGroup" text="Điểm cộng tổ hợp"/>
            </columns>
        </TableView>

        <HBox spacing="8.0" styleClass="toolbar">
            <Label fx:id="pageInfoLabel"
                   styleClass="muted"
                   text="Page 1/1 - 0 priority bonus records"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="prevPageButton"
                    text="Previous"
                    onAction="#onPreviousPage"
                    styleClass="icon-btn"/>
            <Button fx:id="nextPageButton"
                    text="Next"
                    onAction="#onNextPage"
                    styleClass="icon-btn"/>
        </HBox>
    </VBox>
</VBox>

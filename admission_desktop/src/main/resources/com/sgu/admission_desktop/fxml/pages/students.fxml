<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.sgu.admission_desktop.controller.StudentsPageController"
      styleClass="page"
      spacing="14.0"
      VBox.vgrow="ALWAYS">

    <VBox styleClass="card"
          spacing="12.0"
          VBox.vgrow="ALWAYS">

        <HBox spacing="10.0" styleClass="toolbar">
            <TextField fx:id="searchField"
                       promptText="Search by CCCD, name..."
                       HBox.hgrow="ALWAYS"/>

            <Button text="Search"
                    onAction="#onSearch"
                    styleClass="btn-primary"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="Import"
                    onAction="#onImport"
                    styleClass="btn-success"/>

            <Button text="Add new"
                    onAction="#onAddNew"
                    styleClass="btn-primary"/>
        </HBox>

        <HBox spacing="12.0" VBox.vgrow="ALWAYS">
            <VBox spacing="8.0" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
                <TableView fx:id="table"
                           styleClass="table"
                           VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colMaTs" text="Registration"/>
                        <TableColumn fx:id="colHoTen" text="Full name"/>
                        <TableColumn fx:id="colCccd" text="CCCD"/>
                        <TableColumn fx:id="colEmail" text="Email"/>
                        <TableColumn fx:id="colSdt" text="Phone"/>
                    </columns>
                </TableView>
            </VBox>

            <VBox styleClass="card" spacing="10.0" prefWidth="340.0">
                <Label text="Student details" styleClass="card-title"/>
                <Label fx:id="detailHintLabel" text="Select one student to view details." styleClass="muted"/>
                <GridPane hgap="10.0" vgap="8.0">
                    <Label text="Registration:" styleClass="detail-key" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <Label fx:id="detailRegistrationLabel" text="-" styleClass="detail-value" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                    <Label text="Full name:" styleClass="detail-key" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <Label fx:id="detailFullNameLabel" text="-" styleClass="detail-value" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                    <Label text="CCCD:" styleClass="detail-key" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <Label fx:id="detailCccdLabel" text="-" styleClass="detail-value" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                    <Label text="Date of birth:" styleClass="detail-key" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <Label fx:id="detailDateOfBirthLabel" text="-" styleClass="detail-value" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                    <Label text="Gender:" styleClass="detail-key" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                    <Label fx:id="detailGenderLabel" text="-" styleClass="detail-value" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                    <Label text="Email:" styleClass="detail-key" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                    <Label fx:id="detailEmailLabel" text="-" styleClass="detail-value" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
                    <Label text="Phone:" styleClass="detail-key" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                    <Label fx:id="detailPhoneLabel" text="-" styleClass="detail-value" GridPane.rowIndex="6" GridPane.columnIndex="1"/>
                    <Label text="Birth place:" styleClass="detail-key" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
                    <Label fx:id="detailBirthPlaceLabel" text="-" styleClass="detail-value" GridPane.rowIndex="7" GridPane.columnIndex="1"/>
                    <Label text="Applicant type:" styleClass="detail-key" GridPane.rowIndex="8" GridPane.columnIndex="0"/>
                    <Label fx:id="detailApplicantTypeLabel" text="-" styleClass="detail-value" GridPane.rowIndex="8" GridPane.columnIndex="1"/>
                    <Label text="Region:" styleClass="detail-key" GridPane.rowIndex="9" GridPane.columnIndex="0"/>
                    <Label fx:id="detailRegionLabel" text="-" styleClass="detail-value" GridPane.rowIndex="9" GridPane.columnIndex="1"/>
                </GridPane>
            </VBox>
        </HBox>

        <HBox spacing="8.0" styleClass="toolbar">
            <Label fx:id="pageInfoLabel"
                   styleClass="muted"
                   text="Page 1/1 - 0 students"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button fx:id="prevPageButton"
                    text="Previous"
                    onAction="#onPreviousPage"
                    styleClass="icon-btn"/>

            <Button fx:id="nextPageButton"
                    text="Next"
                    onAction="#onNextPage"
                    styleClass="icon-btn"/>
        </HBox>

    </VBox>

</VBox>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.sgu.admission_desktop.controller.WishesPageController"
      styleClass="page"
      spacing="14.0"
      VBox.vgrow="ALWAYS">
    <VBox styleClass="card"
          spacing="12.0"
          VBox.vgrow="ALWAYS">
        <HBox styleClass="toolbar" spacing="10.0">
            <Label text="Quan ly nguyen vong va xet tuyen" styleClass="card-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <TextField fx:id="searchField" promptText="Nhap CCCD"/>
            <Button text="Tim" onAction="#onSearchByCccd" styleClass="icon-btn"/>
            <Button text="Import" onAction="#onImport" styleClass="btn-success"/>
            <Button text="Them moi" onAction="#onAddNew" styleClass="btn-primary"/>
        </HBox>

        <TableView fx:id="table"
                   styleClass="table"
                   VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colMaTs" text="Ma TS"/>
                <TableColumn fx:id="colNguyenVong" text="Nguyen vong"/>
                <TableColumn fx:id="colTenNganh" text="Nganh"/>
                <TableColumn fx:id="colMaToHop" text="To hop"/>
                <TableColumn fx:id="colTongDiem" text="Tong diem"/>
                <TableColumn fx:id="colTrangThai" text="Trang thai"/>
            </columns>
        </TableView>

        <HBox spacing="8.0" styleClass="toolbar">
            <Label fx:id="pageInfoLabel"
                   styleClass="muted"
                   text="Page 1/1 - 0 wishes"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button fx:id="prevPageButton"
                    text="Previous"
                    onAction="#onPreviousPage"
                    styleClass="icon-btn"/>

            <Button fx:id="nextPageButton"
                    text="Next"
                    onAction="#onNextPage"
                    styleClass="icon-btn"/>
        </HBox>
    </VBox>
</VBox>
